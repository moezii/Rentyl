# Frontend (Vite) configuration. Copy to `frontend/.env`.
# VITE_* values are embedded in the public JS bundle: never put secrets here.

# Backend base URL. Leave unset to use `/api` in production builds (served by Nginx).
VITE_API_URL=http://localhost:8000
# Set to `true` to force http://localhost:8000 in development
VITE_USE_LOCAL_API=false

# AMWAL SmartBox environment: UAT | SIT | PRODUCTION
VITE_AMWAL_ENVIRONMENT=UAT

# EmailJS (contact / careers forms). Optional; forms will not send when unset.
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_CAREERS_TEMPLATE_ID=your-emailjs-careers-template-id
